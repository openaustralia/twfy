<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <php>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_USER" value="twfyuser"/>
        <env name="DB_PASSWORD" value="twfypass"/>
        <env name="DB_NAME" value="test_twfy"/>
    </php>
    <testsuites>
        <!-- Pest specs live in tests/Pest, everything else is still a PHPUnit class.
             Converting a test means moving it into tests/Pest. CI runs the suites as
             separate jobs and merges their coverage for Sonar. -->
        <testsuite name="PHPUnit">
            <directory>tests</directory>
            <exclude>tests/Pest</exclude>
        </testsuite>
        <testsuite name="Pest">
            <directory>tests/Pest</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">www/includes</directory>
            <!-- The Plates view templates (resources/views/**) live outside
                 www/includes - without this, HansardPlatesViewsTest.php's coverage of
                 them (and any future view-snippet test) is silently dropped from the
                 report, since PHPUnit's coverage.include filter is separate from
                 which files Xdebug actually executes. -->
            <directory suffix=".php">www/resources</directory>
            <!-- The API code under www/docs/api is tested too (for example
                 ApiLogCallIntegrationTest.php); without this, SonarCloud counts
                 its new lines as uncovered. -->
            <directory suffix=".php">www/docs/api</directory>
        </include>
    </source>
</phpunit>
