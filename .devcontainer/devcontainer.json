// Dev container for VS Code, RubyMine, PhpStorm, Codespaces and the devcontainer CLI. It opens the `webhost`
// container of the same stack `make up` starts. See "Docker development environment" in AGENTS.md.
{
  "name": "OpenAustralia (twfy)",
  "dockerComposeFile": "../compose.yaml",
  "service": "webhost",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  // Waits for the app to finish starting, so the first command you run works. Gives up after START_LIMIT (compose.yaml).
  "postStartCommand": ["sh", ".devcontainer/wait-for-app.sh", "webhost", "dependencies, migrations and Apache", "curl", "-s", "-o", "/dev/null", "http://localhost/"],
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client", "xdebug.php-debug"]
    }
  }
}
